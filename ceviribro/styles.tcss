Screen {
    background: $background;
    color: $foreground;
    padding: 0 1;
}

#langbar {
    height: 1;
}

#langbar Select {
    width: 1fr;
}

#arrow {
    width: 3;
    color: $text-muted;
    text-align: center;
}

#source,
#target {
    height: 1fr;
    border: none;
    padding: 0 1;
    background: $background;
}

#source {
    margin-top: 1;
}

#target {
    border-top: solid $primary;
}

#statusbar {
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

#status {
    width: 1fr;
}

#status.error {
    color: $error;
}

#usage {
    width: auto;
}

#keymap {
    height: 1;
    color: $text-muted;
    padding: 0 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

ApiKeyScreen {
    align: center middle;
    background: $background 75%;
}

#apikey-dialog {
    width: 90%;
    max-width: 60;
    height: auto;
    padding: 1 2;
    background: $surface;
}

#apikey-title {
    color: $foreground;
    text-style: bold;
}

#apikey-input {
    margin: 1 0;
    background: $panel;
}

#apikey-copy {
    color: $text-muted;
}
